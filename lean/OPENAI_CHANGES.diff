+/-! ## Improvement (new; not part of OpenAI's development)
+Grouped recursion: every edge of a role's frame path is ONE batch (one recursive call of size
+|edge|·⌊k/u⌋). The internal exponent is `alpha` (TensorSaving), hence `W = O(n (log n)^q)` with
+q = 1 - 3.2·10⁻⁶. -/
+def improvedExponent : ℝ := 1 - 32/(10:ℝ)^7
+def improvedTime (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ improvedExponent
+
+def ImprovedGoal : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBounds W ∧
+  (fun n => (W n : ℝ)) =O[atTop] improvedTime
+def ImprovedConvGoal : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBounds W ∧
+  (fun n => (W n : ℝ)) =O[atTop] improvedTime
+
+lemma alpha_improved : alpha < improvedExponent := by
+  norm_num [alpha,improvedExponent,Colour.Expo.epsC,Colour.Expo.zC]
+
+theorem transform_improved : ImprovedGoal := by
+  obtain ⟨o,s,a,b,hp,_⟩ := flagshipOne
+  have hN : ∀ n:ℕ, n ≤ id n ∧ id n ≤ 2*n := fun n => ⟨le_rfl,by dsimp; omega⟩
+  refine ⟨o,s,lunch a b id,hp,Skies.time_bound hN a b,?_⟩
+  exact ((Skies.lunch_big a b hN).trans_isLittleO (Skies.flight_little alpha_improved)).isBigO
+
+theorem convolution_improved : ImprovedConvGoal := by
+  obtain ⟨o,s,a,b,hp,_⟩ := flagshipBoth
+  have h (n : ℕ) : n ≤ stretch n ∧ stretch n ≤ 2*n := by unfold stretch; omega
+  refine ⟨o,s,lunch a b stretch,hp,Skies.time_bound h a b,?_⟩
+  exact ((Skies.lunch_big a b h).trans_isLittleO (Skies.flight_little alpha_improved)).isBigO
+
